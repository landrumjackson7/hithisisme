<Window x:Class="CrosshairG.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:CrosshairG"
        Title="Crosshair G — Settings"
        Width="720" Height="560"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F22"
        TextElement.Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ObjectDataProvider x:Key="StyleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:CrosshairStyle" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="Foreground" Value="#B8B8B8" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Section">
            <Setter Property="Margin" Value="0,14,0,6" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#7CD37C" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#2D2F33" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#3A3D42" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Controls -->
        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Crosshair" Style="{StaticResource Section}" />

                <CheckBox Content="Overlay enabled (show crosshair)"
                          IsChecked="{Binding OverlayEnabled}" Margin="0,4,0,0" />

                <TextBlock Text="Style" Style="{StaticResource Label}" />
                <ComboBox ItemsSource="{Binding Source={StaticResource StyleValues}}"
                          SelectedItem="{Binding Style}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Arm length: " />
                    <Run Text="{Binding Size, StringFormat=0}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="60" Value="{Binding Size}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Thickness: " />
                    <Run Text="{Binding Thickness, StringFormat=0.0}" />
                </TextBlock>
                <Slider Minimum="0.5" Maximum="12" Value="{Binding Thickness}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Center gap: " />
                    <Run Text="{Binding Gap, StringFormat=0}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="40" Value="{Binding Gap}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Dot size: " />
                    <Run Text="{Binding DotSize, StringFormat=0.0}" />
                </TextBlock>
                <Slider Minimum="0.5" Maximum="20" Value="{Binding DotSize}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Circle radius: " />
                    <Run Text="{Binding CircleRadius, StringFormat=0}" />
                </TextBlock>
                <Slider Minimum="2" Maximum="80" Value="{Binding CircleRadius}" />

                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Opacity: " />
                    <Run Text="{Binding Opacity, StringFormat=0.00}" />
                </TextBlock>
                <Slider Minimum="0.05" Maximum="1" Value="{Binding Opacity}" />

                <TextBlock Text="Position offset" Style="{StaticResource Section}" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Offset X: " />
                    <Run Text="{Binding OffsetX, StringFormat=0}" />
                </TextBlock>
                <Slider Minimum="-400" Maximum="400" Value="{Binding OffsetX}" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Offset Y: " />
                    <Run Text="{Binding OffsetY, StringFormat=0}" />
                </TextBlock>
                <Slider Minimum="-400" Maximum="400" Value="{Binding OffsetY}" />

                <TextBlock Text="Color" Style="{StaticResource Section}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="Green"   Click="Preset_Click" Tag="0,220,0" />
                    <Button Content="Red"     Click="Preset_Click" Tag="230,20,20" />
                    <Button Content="Cyan"    Click="Preset_Click" Tag="0,220,220" />
                    <Button Content="Magenta" Click="Preset_Click" Tag="230,0,230" />
                    <Button Content="Yellow"  Click="Preset_Click" Tag="240,220,0" />
                    <Button Content="White"   Click="Preset_Click" Tag="255,255,255" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}"><Run Text="Red" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding R}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Green" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding G}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Blue" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding B}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Alpha" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding A}" />

                <TextBlock Text="Outline" Style="{StaticResource Section}" />
                <CheckBox Content="Enable outline" IsChecked="{Binding OutlineEnabled}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Label}">
                    <Run Text="Outline thickness: " />
                    <Run Text="{Binding OutlineThickness, StringFormat=0.0}" />
                </TextBlock>
                <Slider Minimum="0" Maximum="6" Value="{Binding OutlineThickness}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Outline Red" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding OR}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Outline Green" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding OG}" />
                <TextBlock Style="{StaticResource Label}"><Run Text="Outline Blue" /></TextBlock>
                <Slider Minimum="0" Maximum="255" Value="{Binding OB}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Live preview -->
        <Border Grid.Row="0" Grid.Column="2" Background="#101114" CornerRadius="6"
                BorderBrush="#2A2C30" BorderThickness="1">
            <Grid>
                <Canvas x:Name="PreviewCanvas" ClipToBounds="True"
                        SizeChanged="PreviewCanvas_SizeChanged" />
                <TextBlock Text="Live preview" Foreground="#555" Margin="8"
                           VerticalAlignment="Top" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Reset to defaults" Click="Reset_Click" />
            <Button Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
