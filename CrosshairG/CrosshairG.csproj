<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building this Windows-targeted app from non-Windows CI/build hosts. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CrosshairG</AssemblyName>
    <RootNamespace>CrosshairG</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Crosshair G</Product>
    <AssemblyTitle>Crosshair G</AssemblyTitle>
    <Company>Crosshair G</Company>
    <!-- Suppress the WinForms/WPF combined-app warning; both are used intentionally
         (WPF for the overlay/UI, WinForms NotifyIcon for the tray). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
